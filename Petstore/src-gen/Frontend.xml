		</location>
		<location id="id5">
			<name>id5</name>
		</location>
		
		<init ref="id5"/>
		
		<transition>
			<source ref="id1"/>
			<target ref="id2"/>
				<label kind="synchronisation" >parallel[1]!</label>
		</transition>
		<transition>
			<source ref="id4"/>
			<target ref="id1"/>
				<label kind="synchronisation" >completed[0]!</label>
				<label kind="assignment" >prepareExecution(0)</label>
		</transition>
		<transition>
			<source ref="id5"/>
			<target ref="id4"/>
		</transition>
		<transition>
			<source ref="id2"/>
			<target ref="id5"/>
		</transition>
		</template>
