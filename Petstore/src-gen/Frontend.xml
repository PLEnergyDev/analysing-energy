		<template>
		<name>CloudExecutor</name>
		<declaration>
		void executeFragment(int fragmentId) {
			// Calculate energy consumption based on fragment characteristics
			int computationEnergy = Info[fragmentId].instructions * cloudEnergyPerInstruction;
			int memoryEnergy = Info[fragmentId].memory * cloudEnergyPerMemoryUnit;
			int communicationEnergy = Info[fragmentId].communicationData * cloudEnergyPerDataUnit;
			
			// Update total energy consumption
			totalEnergyConsumed += computationEnergy + memoryEnergy + communicationEnergy;
			
			// Update execution time
			executionTime += ((Info[fragmentId].instructions * 10) / cloudInstructions);
			if(executionTime == 0) executionTime = 1; // Minimum execution time
			
			// Mark fragment as completed
			fragmentsCompleted[fragmentId] = true;
		}
		</declaration>
		
		
		<location id="id18">
			<name>id18</name>
		</location>
		<location id="id19">
			<name>id19</name>
			<committed/>
		</location>
		
		<init ref="id18"/>
		
		<transition>
			<source ref="id18"/>
			<target ref="id19"/>
				<label kind="select" >f : id_t</label>
				<label kind="synchronisation" >completed[f]?</label>
				<label kind="assignment" >currentFragment = f</label>
		</transition>
		<transition>
			<source ref="id19"/>
			<target ref="id18"/>
				<label kind="assignment" >executeFragment(currentFragment)</label>
		</transition>
		</template>
		<template>
		<name>EnergyMonitor</name>
		<declaration>
		// Energy monitoring functions
		bool allFragmentsCompleted() {
			int i;
			for(i = 0; i &lt; N; i++) {
				if(!fragmentsCompleted[i]) return false;
			}
			return true;
		}
		
		int calculateTotalEnergy() {
			return totalEnergyConsumed;
		}
		
		int calculateAverageEnergyPerFragment() {
			if(N > 0) return totalEnergyConsumed / N;
			return 0;
		}
		</declaration>
		
		
		<location id="id20">
			<name>id20</name>
		</location>
		<location id="id21">
			<name>id21</name>
		</location>
		
		<init ref="id20"/>
		
		<transition>
			<source ref="id20"/>
			<target ref="id21"/>
				<label kind="guard" >allFragmentsCompleted()</label>
				<label kind="assignment" >finalEnergyConsumption = calculateTotalEnergy()</label>
		</transition>
		</template>
		
		<system>system USER_INTERFACE,API_GATEWAY,RENDER,RENL,RENS,CloudExecutor, EnergyMonitor;</system>
		</nta>