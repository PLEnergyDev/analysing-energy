<?xml version="1.0" encoding="utf-8"?><!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_1.dtd'>
		<nta>
		<declaration>// Cloud-only energy consumption model
		const int N=5;
		typedef int[0, N-1] id_t;
		
		// Cloud computing parameters
		const int cloudInstructions=600;
		
		// Energy consumption parameters (units: millijoules)
		const int cloudEnergyPerInstruction = 5;    // mJ per instruction
		const int cloudEnergyPerMemoryUnit = 1;     // mJ per memory unit
		const int cloudEnergyPerDataUnit = 1;       // mJ per communication data unit
		
		// Communication channels
		chan execute[N], completed[N], parallel[N];
		
		// Energy tracking variables
		int totalEnergyConsumed = 0;
		int finalEnergyConsumption = 0;
		int executionTime = 0;
		
		// Fragment tracking
		int currentFragment;
		bool fragmentsCompleted[N];
		int fragmentsExecuted = 0;
		
		// Fragment information structure
		typedef struct {
			int instructions;           // Number of instructions to execute
			int memory;                // Memory requirements
			int communicationData;     // Data transfer requirements
		} FragmentInfo;
		
		const FragmentInfo Info[N] = {
			{15, 2, 1}
			,
			{30, 10, 5}
			,
			{60, 20, 8}
			,
			{7, 3, 0}
			,
			{5, 3, 1}
		};
		
		
		
		// Helper functions
		void prepareExecution(int fragmentId) {
			// Initialize fragment for execution
			fragmentsCompleted[fragmentId] = false;
		}
		</declaration>
		<template>
		<name x="5" y="5"> USER_INTERFACE </name>
		<declaration></declaration>
		
